# Server-side secrets (keep strictly on the backend; never expose to the client)
GEMINI_API_KEY=
APPWRITE_API_KEY=
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=

# Client-side public Appwrite configuration
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_BUCKET_MEDIA=media

# Optional S3-compatible access (ONLY if using external S3 tools; keep real credentials in .env.local, never here)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=